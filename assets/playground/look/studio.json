  "prompts": {
    "pose": "One full-body figure, {figure}, standing on a plain light grey studio background. It only shows the pose: the whole figure from the top of the head to the feet is in the picture, with a little space above and below. Facing the camera, standing relaxed and straight with the weight on both feet, arms hanging a little away from the body, hands open. Soft even studio light, no shadow on the background, no props, no text. A clean pose reference picture.",
    "pose_aspect": "2:3",
    "sheet": "A character reference sheet of the person in the reference picture: three views side by side on one plain light grey studio background, the same person in each, from left to right: a front close-up of the head and shoulders, a three-quarter view from the knees up, and a full-length view from head to feet facing the camera, standing relaxed. Soft even studio light, no props, no text, no labels.",
    "sheet_aspect": "16:9",
    "first": "Edit this picture: make the person this fantasy hero: {description}. Keep the exact pose, the framing from the top of the head to the feet, the plain light studio background and the light. Dress them as described, or in simple adventuring clothes that suit them when no clothes are described.",
    "edit": "Edit this picture of the hero. Change only this: {changes}. Keep everything else exactly as it is: the pose, the framing from head to feet, the face, the body, the clothes, the background and the light.",
    "pose_shows": "the base pose and framing every version keeps",
    "lock_sheet": "Edit this reference sheet: put the hero of the reference picture into all three views, the same person in each, with their face, hair, skin, build, height, marks, clothes and gear exactly as the reference shows them: on the left a front close-up of the head and shoulders, in the middle a three-quarter view from the knees up, on the right a full-length view from head to feet. Keep the three framings and the plain studio background. No text, no labels.",
    "context": "species {species}, class {class}",
    "detail": "{what} ({kind} on the {region})",
    "add": "add {detail}",
    "remove": "remove {detail}",
    "change": "{noun} from {old} to {new}",
    "example_species": "A photographic half-body portrait of {what}, in simple adventuring clothes, against a softly blurred fantasy village street. Looking toward the camera. Natural light.",
    "example_class": "A dramatic photographic half-body action shot of {what}, against a softly blurred fantasy landscape. Cinematic natural light; any magic is clearly visible.",
    "ready": "Edit this picture: show this same hero, full body from head to feet, in a ready stance: {pose}. Keep their face, hair, skin, build, height, marks, clothes and gear exactly as the reference sheet and this picture show them. A dramatic three-quarter view on a plain dark studio ground with a soft rim light; the whole figure in the picture, nothing cut off. No text.",
    "headshot": "Edit this picture: a square head-and-shoulders portrait of this same hero, facing the viewer, the face sharp and well lit; keep their face, hair, skin, marks and clothes exactly as the reference sheet and this picture show them. A plain dark studio ground. No text.",
    "headshot_aspect": "1:1",
    "half_portrait": "Edit this picture: a half-body portrait of this same hero from the waist up, turned slightly, at ease; keep their face, hair, skin, build, marks, clothes and gear exactly as the reference sheet and this picture show them. A plain dark studio ground with a soft rim light. No text.",
    "half_portrait_aspect": "3:4"
  },
