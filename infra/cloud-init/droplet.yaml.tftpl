#cloud-config
# First-boot configuration for a DungeonFlux ${role} Droplet (plan 12.2, 12.5, 12.7). Rendered by
# infra/terraform/modules/droplet with templatefile(); runs ONCE at creation. STATUS: UNVERIFIED.
# It installs Docker (app and worker roles), prepares directories, users and one-group-per-consumer secret
# groups, and installs the root-owned tools: df-secrets-install, df-deploy and df-deploy-ssh. It carries NO secret
# and no application config: secrets arrive through df-secrets-install onto tmpfs, and releases through df-deploy.
#
# WHO CAN DO WHAT (critic rounds 1c and 1d; coordinator rulings b, c and d):
#  * Nobody who logs in is in the docker group. Docker socket access is host root (a container can bind-mount
#    /run/dungeonflux and read every consumer's secrets), so containers are started only by root, through
#    df-deploy, which validates its arguments and verifies every release and key set with cosign against the pinned identity.
#  * CI: one key with the forced command df-deploy-ssh on the dfdeploy account (only "secrets-install" and
#    "deploy <digest>"), reached through the bastion's dfci account, which may only forward to the application and
#    worker hosts' SSH port. sudo lets dfdeploy run exactly `df-secrets-install` (no arguments) and
#    `df-deploy sha256:<digest>`; df-deploy re-checks that it got exactly one argument. Until df-deploy verifies
#    releases, that key is root-equivalent in effect and is handled as such.
#  * Humans: one account each (admin_users), sk-ssh-ed25519@openssh.com (FIDO2 hardware key) public keys only,
#    each installed with verify-required, so a login needs the key's touch AND its PIN. On the bastion and on the
#    hosts their only sudo rights are `df-secrets-install` (also --audit) and `df-deploy psql ...` (database
#    administration). They cannot start containers or release. No shared human account exists.
#  * KEYS ARE ROOT-OWNED FILES: sshd reads /etc/ssh/authorized_keys.d/<user> (owned by root), never a file the user can
#    edit, so a compromised account cannot add a key for itself. This template runs once, and Terraform changes do NOT reach
#    a running host. TO ADD OR REVOKE A KEY ON AN EXISTING HOST (application and worker roles) CI runs
#    `df-deploy refresh-keys <digest>`: the digest of a reviewed key-set image signed by the pinned CI identity, verified with
#    cosign, validated and applied by df-keys-apply. The bastion has no registry access and is replaced monthly instead.
# Keep shell variables in $NAME form here: a dollar sign followed by a brace belongs to Terraform.
%{ if role != "bastion" }
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - jq
  - age
  - socat
  - iptables
  - dnsmasq-base
  - unattended-upgrades
%{ else }
# The bastion has no outbound 80/443 unless package_mirror_cidrs is set (ruling d), so it installs nothing at first
# boot and cannot be patched in place: it holds no state and no secret; replace it (terraform taint) to patch it.
package_update: false
package_upgrade: false
%{ endif }

bootcmd:
%{ if role != "bastion" }
  # One Unix group per secrets consumer (gids match infra/cloud-init/df-secrets-install.sh and the services'
  # primary gids). No login account is in any of them, so none can read a secret it pushes.
  - [cloud-init-per, once, dfs-control-plane, groupadd, -g, "10001", dfs-control-plane]
  - [cloud-init-per, once, dfs-runtime, groupadd, -g, "10002", dfs-runtime]
  - [cloud-init-per, once, dfs-dispatcher, groupadd, -g, "10003", dfs-dispatcher]
  - [cloud-init-per, once, dfs-runner, groupadd, -g, "10004", dfs-runner]
  - [cloud-init-per, once, dfs-backup, groupadd, -g, "10005", dfs-backup]
  - [cloud-init-per, once, dfs-monitoring, groupadd, -g, "10006", dfs-monitoring]
  - [cloud-init-per, once, dfs-billing-worker, groupadd, -g, "10007", dfs-billing-worker]
  - [cloud-init-per, once, dfs-ingestor, groupadd, -g, "10008", dfs-ingestor]
  - [cloud-init-per, once, dfs-edge, groupadd, -g, "10010", dfs-edge]
  - [cloud-init-per, once, dfs-deploy, groupadd, -g, "10020", dfs-deploy]
%{ else }
  - [cloud-init-per, once, noop, true]
%{ endif }

# Accounts have NO ssh_authorized_keys here: their keys are the root-owned files written below.
users:
%{ if role == "bastion" }
  # CI reaches the hosts THROUGH the bastion (ssh -J): this account only forwards, it has no shell.
  - name: dfci
    shell: /usr/sbin/nologin
    lock_passwd: true
%{ else }
  - name: dfdeploy
    shell: /bin/bash
    lock_passwd: true
%{ endif }
%{ for name, keys in admin_users }
  - name: ${name}
    shell: /bin/bash
    lock_passwd: true
%{ endfor }

write_files:
  - path: /etc/ssh/sshd_config.d/10-dungeonflux.conf
    permissions: "0644"
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      AuthorizedKeysFile /etc/ssh/authorized_keys.d/%u
      MaxAuthTries 3
      LoginGraceTime 20
      X11Forwarding no
%{ if role == "bastion" }
      AllowTcpForwarding yes
      PermitTunnel no
%{ else }
      AllowTcpForwarding no
%{ endif }

  # AllowUsers lives in its own file, which df-keys-apply rewrites when the key set changes (sshd keeps the FIRST value it
  # reads, so this file sorts before 10-dungeonflux.conf).
  - path: /etc/ssh/sshd_config.d/05-allowusers.conf
    permissions: "0644"
    content: |
      AllowUsers ${allowed_users}

%{ if role == "bastion" }
  # dfci may open a tunnel ONLY to the SSH port of an application or worker host (ruling d). permitopen takes literal
  # addresses (no wildcards), so the private IPs of the hosts are written here by Terraform after they exist.
  - path: /etc/ssh/authorized_keys.d/dfci
    permissions: "0644"
    owner: root:root
    content: |
%{ for key in ci_deploy_authorized_keys }
      restrict,port-forwarding%{ for ip in ssh_target_ips },permitopen="${ip}:22"%{ endfor } ${key}
%{ endfor }
%{ else }
  - path: /etc/ssh/authorized_keys.d/dfdeploy
    permissions: "0644"
    owner: root:root
    content: |
%{ for key in ci_deploy_authorized_keys }
      command="/usr/local/sbin/df-deploy-ssh",restrict ${key}
%{ endfor }
%{ endif }
%{ for name, keys in admin_users }

  - path: /etc/ssh/authorized_keys.d/${name}
    permissions: "0644"
    owner: root:root
    content: |
%{ for key in keys }
      verify-required ${key}
%{ endfor }
%{ endfor }
%{ if role != "bastion" }

  # live-restore is OFF on purpose (round 3): containers are not kept alive across a daemon restart; Docker starts every container with a
  # restart policy again, which also makes the proxy's single-file socket mount fresh (see the docker.service drop-in below).
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "local",
        "log-opts": { "max-size": "20m", "max-file": "5" },
        "live-restore": false,
        "no-new-privileges": true,
        "userland-proxy": false,
        "icc": false,
        "default-ulimits": { "nofile": { "Name": "nofile", "Hard": 65536, "Soft": 65536 } }
      }

  # Secrets live on tmpfs only. /run/dungeonflux/docker is DOCKER_CONFIG for registry logins made by df-deploy
  # (root): the login token goes to memory, never to ~/.docker/config.json on the Droplet disk (it would reach
  # Droplet backups). Consumer directories under secrets/ are created by df-secrets-install with their own group.
  - path: /etc/tmpfiles.d/dungeonflux.conf
    permissions: "0644"
    content: |
      d /run/dungeonflux 0755 root root -
      d /run/dungeonflux/secrets 0755 root root -
      d /run/dungeonflux/docker 0700 root root -
      # The proxy (uid 10013) creates its socket here; the runner (gid 10004) connects through the group. setgid keeps the group.
      d /run/dungeonflux/runner 2750 10013 10004 -
      # The slot tree is built by df-slot-dirs (root); this only guarantees the top directory is root-owned before anything else runs.
      d /run/dungeonflux/runtime 0755 root root -

  # What this host is, and the CI identity that may sign what it runs. The identity is EXACT (never a pattern): the workflow
  # of the reviewed main branch that builds and signs releases and key sets. Written once; changing it is a host replacement.
  - path: /etc/dungeonflux/host-role
    permissions: "0644"
    owner: root:root
    content: |
      ${role}

  - path: /etc/dungeonflux/cosign-identity
    permissions: "0644"
    owner: root:root
    content: |
      identity=${cosign_certificate_identity}
      keys_identity=${cosign_keys_certificate_identity}
      issuer=${cosign_oidc_issuer}

  - path: /etc/dungeonflux/release-source
    permissions: "0644"
    owner: root:root
    content: |
      prefix=${release_repository_prefix}
      registry_user=${release_registry_user}

  - path: /usr/local/sbin/df-slot-dirs
    permissions: "0755"
    owner: root:root
    content: |
      ${indent(6, slot_dirs_script)}

  # Builds the per-slot tree under /run/dungeonflux/runtime at every boot (it is tmpfs), before Docker starts anything. No release is
  # staged on a fresh host, so the condition skips the unit until the first `df-deploy release` (which also runs the helper).
  - path: /etc/systemd/system/df-slot-dirs.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=DungeonFlux runtime slot directories
      After=local-fs.target
      Before=docker.service
      ConditionPathExists=/opt/dungeonflux/current/config/runner.toml
      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/sbin/df-slot-dirs --config /opt/dungeonflux/current/config/runner.toml
      [Install]
      WantedBy=multi-user.target

  - path: /usr/local/sbin/df-net-rules
    permissions: "0755"
    owner: root:root
    content: |
      ${indent(6, net_rules_script)}

  # This VPC's CIDR: the egress rules drop it for the control plane and the dispatcher (the database and every other VPC host are
  # reached only through the db-gate, never from a bridge with a route out).
  - path: /etc/dungeonflux/vpc-cidr
    permissions: "0644"
    owner: root:root
    content: |
      ${vpc_cidr}

  # Installs the DOCKER-USER rules for the three bridges with a route out at every boot, before Docker. The database address comes from
  # the active release's host.env; before the first release the db bridge reaches nothing.
  - path: /etc/systemd/system/df-net-rules.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=DungeonFlux egress rules for the Docker bridges
      After=network-online.target
      Wants=network-online.target
      Before=docker.service
      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/sbin/df-net-rules --auto
      [Install]
      WantedBy=multi-user.target

  # FAIL CLOSED: docker.service cannot start without the egress rules (Requires), and re-applies them after every start
  # (ExecStartPost: the rules also follow a change of the managed cluster's address).
  - path: /etc/systemd/system/docker.service.d/10-df-net-rules.conf
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Requires=df-net-rules.service
      After=df-net-rules.service
      [Service]
      ExecStartPost=/usr/local/sbin/df-net-rules --auto
      # The proxy bind-mounts the single file /var/run/docker.sock; a mount made before the daemon recreated that socket would go stale.
      # With live-restore off (daemon.json below) Docker restarts every container with a restart policy, so the mount is made afresh anyway;
      # this hook restarts the proxy and the runner once more after the daemon is up, as a belt and braces (failure is ignored).
      ExecStartPost=-/usr/local/sbin/df-stack restart-proxy

  # The edge's non-secret environment: hostnames, the certificate contact and the access gate (deploy/config/edge.env.production.example).
  # Terraform values; the Caddyfile fails closed when DF_PUBLIC_HOST is empty.
  - path: /etc/dungeonflux/edge.env
    permissions: "0644"
    owner: root:root
    content: |
%{ for key, value in edge_environment }
      ${key}=${value}
%{ endfor }

  - path: /usr/local/sbin/df-db-dns
    permissions: "0755"
    owner: root:root
    content: |
      ${indent(6, db_dns_script)}

  # The database-only resolver stub: answers names under the database suffix only, listens on the database bridge's gateway address.
  - path: /etc/systemd/system/df-db-dns.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=DungeonFlux database-only DNS stub
      After=network-online.target
      Wants=network-online.target
      [Service]
      ExecStartPre=/usr/local/sbin/df-db-dns --write /run/dungeonflux/db-dns.conf
      ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/run/dungeonflux/db-dns.conf --pid-file=
      Restart=always
      RestartSec=2
      NoNewPrivileges=yes
      ProtectHome=yes
      PrivateTmp=yes
      CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_NET_ADMIN CAP_NET_RAW
      [Install]
      WantedBy=multi-user.target

  # The database addresses move in a failover: re-resolve them and replace the firewall rules every 30 seconds.
  - path: /etc/systemd/system/df-net-rules-refresh.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=DungeonFlux firewall refresh (database addresses)
      After=df-net-rules.service
      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/df-net-rules --auto
  - path: /etc/systemd/system/df-net-rules-refresh.timer
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=DungeonFlux firewall refresh every 30 seconds
      [Timer]
      OnBootSec=30s
      OnUnitActiveSec=30s
      AccuracySec=2s
      [Install]
      WantedBy=timers.target

  - path: /usr/local/sbin/df-stack
    permissions: "0755"
    owner: root:root
    content: |
      ${indent(6, stack_script)}

  - path: /usr/local/sbin/df-backup
    permissions: "0755"
    owner: root:root
    content: |
      ${indent(6, backup_script)}

  - path: /usr/local/sbin/df-host-metrics
    permissions: "0755"
    owner: root:root
    content: |
      ${indent(6, host_metrics_script)}

  # The nightly encrypted backup (daily, random delay so hosts do not all dump at once; Persistent runs a missed one at boot).
  - path: /etc/systemd/system/df-backup.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=DungeonFlux encrypted database backup
      After=docker.service
      Requires=docker.service
      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/df-backup run
      TimeoutStartSec=3h
  - path: /etc/systemd/system/df-backup.timer
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=Daily DungeonFlux backup
      [Timer]
      OnCalendar=*-*-* 02:30:00 UTC
      RandomizedDelaySec=30min
      Persistent=true
      [Install]
      WantedBy=timers.target

  # Host facts for Prometheus (disk, secrets present, alert receiver), once a minute.
  - path: /etc/systemd/system/df-host-metrics.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=DungeonFlux host metrics (textfile)
      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/df-host-metrics
  - path: /etc/systemd/system/df-host-metrics.timer
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=DungeonFlux host metrics every minute
      [Timer]
      OnBootSec=1min
      OnUnitActiveSec=1min
      AccuracySec=5s
      [Install]
      WantedBy=timers.target

  - path: /usr/local/sbin/df-keys-apply
    permissions: "0755"
    owner: root:root
    content: |
      ${indent(6, keys_apply_script)}

  # The live allow-list: digest-pinned images the proxy lets the runner start, plus the pinned psql client. It lives in a DIRECTORY that
  # containers mount, and `df-deploy activate` replaces the file by rename. A change here is a change of the pinned psql client
  # (PostgreSQL 17 or later).
  - path: /etc/dungeonflux/allowed-images.d/allowed
    permissions: "0644"
    owner: root:root
    content: |
      psql=${psql_image}

  # The ONLY host-name suffix df-deploy psql may relay to (managed PostgreSQL cluster names); written once, root-owned.
  - path: /etc/dungeonflux/db-host-suffix
    permissions: "0644"
    owner: root:root
    content: |
      .db.ondigitalocean.com

  - path: /usr/local/sbin/df-secrets-install
    permissions: "0755"
    owner: root:root
    content: |
      ${indent(6, secrets_install_script)}

  - path: /usr/local/sbin/df-deploy
    permissions: "0755"
    owner: root:root
    content: |
      ${indent(6, deploy_script)}

  - path: /usr/local/sbin/df-deploy-ssh
    permissions: "0755"
    owner: root:root
    content: |
      ${indent(6, deploy_ssh_script)}

  # Fixed argument patterns (sudoers: "" means no arguments; the wildcard after sha256\: matches the rest of ONE
  # argument list, which is why df-deploy itself insists on exactly one argument). The CI account can do nothing
  # else; operators can do database administration and the secrets audit, but cannot release or start containers.
  - path: /etc/sudoers.d/dungeonflux-deploy
    permissions: "0440"
    owner: root:root
    content: |
      dfdeploy ALL=(root) NOPASSWD: /usr/local/sbin/df-secrets-install "", /usr/local/sbin/df-deploy sha256\:*, /usr/local/sbin/df-deploy release sha256\:*, /usr/local/sbin/df-deploy migrate sha256\:*, /usr/local/sbin/df-deploy activate sha256\:*, /usr/local/sbin/df-deploy rollback, /usr/local/sbin/df-deploy refresh-keys sha256\:*

  # The operators' rights live in a separate file that df-keys-apply regenerates from each signed key set.
  - path: /etc/sudoers.d/dungeonflux-admins
    permissions: "0440"
    owner: root:root
    content: |
      # Written by cloud-init at first boot and regenerated by df-keys-apply. Do not edit.
%{ for name, keys in admin_users }
      ${name} ALL=(root) NOPASSWD: /usr/local/sbin/df-secrets-install "", /usr/local/sbin/df-secrets-install --audit, /usr/local/sbin/df-deploy psql *, /usr/local/sbin/df-backup record-drill *
%{ endfor }

  - path: /usr/local/sbin/df-bootstrap.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      systemd-tmpfiles --create /etc/tmpfiles.d/dungeonflux.conf

      # Docker Engine from Docker's own apt repository. The signing key fingerprint is verified, not trusted.
      install -m 0755 -d /etc/apt/keyrings
      curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
      fingerprint=$(gpg --show-keys --with-colons /etc/apt/keyrings/docker.asc | awk -F: '/^fpr:/ {print $10; exit}')
      if [ "$fingerprint" != "9DC858229FC7DD38854AE2D88D81803C0EBFCD88" ]; then
        echo "unexpected Docker apt key fingerprint: $fingerprint" >&2
        exit 1
      fi
      . /etc/os-release
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $VERSION_CODENAME stable" > /etc/apt/sources.list.d/docker.list
      apt-get update
      # Every Docker package is pinned and then held (package_upgrade above must not move them). The compose plugin is installed because
      # df-stack drives the production stack with it; it is pinned and held like the engine.
      DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce=${docker_version_pin} docker-ce-cli=${docker_version_pin} containerd.io=${containerd_version_pin} docker-compose-plugin=${compose_version_pin}
      apt-mark hold docker-ce docker-ce-cli containerd.io docker-compose-plugin
      systemctl daemon-reload
      systemctl enable df-slot-dirs.service df-net-rules.service df-net-rules-refresh.timer df-db-dns.service df-host-metrics.timer
      systemctl start df-db-dns.service df-net-rules-refresh.timer || true
%{ if role == "app" }
      systemctl enable df-backup.timer
%{ endif }
      systemctl start df-net-rules.service
      systemctl enable --now docker

      # cosign: a pinned release whose SHA-256 is checked before it is installed. df-deploy uses it to verify every release and
      # key set against the pinned CI identity. (The checksum is supplied by Terraform; the owner takes it from the verified
      # release's published checksums.)
      curl -fsSL -o /usr/local/bin/cosign.new "https://github.com/sigstore/cosign/releases/download/${cosign_version}/cosign-linux-amd64"
      echo "${cosign_sha256}  /usr/local/bin/cosign.new" | sha256sum -c -
      install -m 0755 -o root -g root /usr/local/bin/cosign.new /usr/local/bin/cosign
      rm -f /usr/local/bin/cosign.new
      # NO usermod -aG docker: nobody who logs in may talk to the Docker socket (it is host root).

      # Directories. Writable application state lives on the host disk and is owned by the SERVICE's own uid
      # (one uid per service: control-plane 10001, dispatcher 10003, ingestor 10008); it is working storage, never
      # the only copy of anything (plan 12.1). Each runtime's spool and secrets live on tmpfs under /run/dungeonflux/runtime, in directories
      # df-slot-dirs creates (root) for the slot's own uid (20000 + slot); the ingestor's telemetry store is never shared with a runtime.
      install -d -o root -g root -m 0755 /opt/dungeonflux /opt/dungeonflux/releases /var/lib/dungeonflux /var/lib/dungeonflux/spool
      install -d -o 10008 -g 10008 -m 0750 /var/lib/dungeonflux/telemetry
      install -d -o 10010 -g 10010 -m 0750 /var/lib/dungeonflux/caddy
      # Monitoring state (round 3): Prometheus 10014, Alertmanager 10006; the textfile directory is written by root and read by the exporter;
      # the backup staging directory belongs to the backup container's uid 10005 and holds only ciphertext, briefly.
      install -d -o 10014 -g 10014 -m 0750 /var/lib/dungeonflux/prometheus
      install -d -o 10006 -g 10006 -m 0750 /var/lib/dungeonflux/alertmanager
      install -d -o root -g root -m 0755 /var/lib/dungeonflux/textfile
      install -d -o 10005 -g 10005 -m 0700 /var/lib/dungeonflux/backup /var/lib/dungeonflux/backup/staging
      install -d -o 10001 -g 10001 -m 0750 /var/lib/dungeonflux/spool/control-plane
      install -d -o 10003 -g 10003 -m 0750 /var/lib/dungeonflux/spool/dispatcher
%{ if role == "app" }
      install -d -o root -g root -m 0755 /opt/dungeonflux/edge /opt/dungeonflux/docs
%{ endif }

      systemctl reload ssh || systemctl restart ssh
      touch /var/lib/dungeonflux/.bootstrapped
%{ endif }

runcmd:
%{ if role != "bastion" }
  - [bash, /usr/local/sbin/df-bootstrap.sh]
%{ else }
  - [systemctl, reload, ssh]
%{ endif }
