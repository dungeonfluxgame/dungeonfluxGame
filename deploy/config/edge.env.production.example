# Non-secret environment of the Caddy edge in PRODUCTION (LAUNCH.md decision 32). Installed by the production deploy as
# /etc/dungeonflux/edge.env and given to the edge container with --env-file. Hostnames are configuration: change them
# here and in Terraform's public_hostname, nowhere else. DNS is entered by hand at GoDaddy (deploy/dns/records.csv);
# agents change no DNS or registrar setting.
#
# Production is ONE public origin. The www host redirects to it (deploy/edge/extra/www-redirect.caddy is copied to
# /etc/caddy/extra/ in production only).
DF_PUBLIC_HOST=dungeonfluxdnd.com
# A mailbox the owner reads: the certificate authority writes expiry and problem notices there. Required.
DF_ACME_EMAIL=
# Who may use the site: space-separated CIDRs. Production is open to everyone, EXPLICITLY. If this variable is missing the
# Caddyfile defaults to loopback only and the site answers 403 to everybody (it fails closed).
DF_ALLOWED_CIDRS=0.0.0.0/0 ::/0
# Behind the optional DigitalOcean load balancer set this to the VPC range; without one keep the default.
DF_TRUSTED_PROXIES=private_ranges
