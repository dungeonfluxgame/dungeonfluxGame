# Non-secret environment of the Caddy edge in the STAGING environment (LAUNCH.md decision 32): the same Caddyfile.production,
# with the staging hostname and NO www site (the staging deploy mounts an empty /etc/caddy/extra/). The local compose mirror
# uses Caddyfile.staging on 127.0.0.1 and needs none of this. The A record is in deploy/dns/records.csv (pre-2), entered by
# hand at GoDaddy.
DF_PUBLIC_HOST=staging.dungeonfluxdnd.com
DF_ACME_EMAIL=
# STAGING IS A PUBLIC NAME IN FRONT OF A FAKE IDENTITY PROVIDER, so the edge answers 403 to every client outside this list
# (space-separated CIDRs: the owner's and the testers' addresses). The firewall stays open on 80/443 so the certificate
# authority can still validate the name; Caddy answers ACME challenges before the gate runs. Required: with nothing here the
# staging site is unreachable (loopback only), which is the safe default.
DF_ALLOWED_CIDRS=REPLACE_ME/32
DF_TRUSTED_PROXIES=private_ranges
