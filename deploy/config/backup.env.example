# Non-secret settings for the backup timer (deploy/scripts/backup-*.sh, round 2). Copy to the host as
# /etc/dungeonflux/backup.env. Credentials are FILES in /run/secrets (the backup consumer's directory), never here.

# Primary backups: the environment's own backups bucket (storage_backups_*: limited to that bucket, NOT write-only; versioning and the lifecycle
# rule make an overwrite or delete recoverable for seven days).
DF_BACKUP_ENDPOINT=https://nyc3.digitaloceanspaces.com
DF_BACKUP_BUCKET=dfx-prod-backups
DF_BACKUP_REGION=nyc3
DF_BACKUP_RETENTION_DAYS=30

# SECOND DESTINATION OUTSIDE THE PRODUCTION CREDENTIALS' DESTRUCTIVE AUTHORITY (plan 13.10; coordinator
# decision h). The owner chooses the provider and account later: a second S3-compatible target with a
# WRITE-ONLY credential (offsite_access_key_id / offsite_secret_key in the backup consumer's directory) that
# cannot delete or overwrite what it wrote. Left EMPTY on purpose: while DF_OFFSITE_ENDPOINT is empty the
# off-site copy is disabled and the backup job reports "offsite: not configured" in its status line, which
# the alert rules treat as a standing P2 reminder, not as success.
DF_OFFSITE_ENDPOINT=
DF_OFFSITE_BUCKET=
DF_OFFSITE_REGION=

# The recovery-journal head watermark (service-operations.md) is held off-host by the owner's choice of
# provider; nothing here decides it. TODO(owner,O2): where the latest verified head is published.
