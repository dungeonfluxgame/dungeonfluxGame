# Install /etc/dungeonflux/portal.env with these names. Secret values are host supplied.
# Public profile settings (demo.env supplies shared gameplay names):
DF_PROFILE
DF_PORTAL_LISTEN
DF_PORTAL_TRUSTED_PROXIES
DF_PORTAL_BUNDLE_DIR
DF_GAMEPLAY_PUBLIC_URL
DF_GAMEPLAY_DATABASE_TLS
DF_GAMEPLAY_IDENTITY
DF_GAMEPLAY_MAIL_MODE
DF_MAIL_FROM
DF_MAIL_REPLY_TO
# Runtime role URL: accounts/campaign reads and writes plus finance facade privileges.
DF_PORTAL_DATABASE_URL
# Optional separate migration role URL for the SAME host/port/database; remove after provisioning.
DF_PORTAL_MIGRATOR_DATABASE_URL
# Required for verify-full TLS; local demo uses explicitly configured loopback-plaintext.
DF_PORTAL_DATABASE_CA_FILE
# Stable distinct 64 lowercase hexadecimal secrets shared by all portal replicas:
DF_CAMPAIGN_IP_KEY
DF_CAMPAIGN_CODE_KEY
# Durable B trial-grant HMAC key: retain across account deletion; must differ from both campaign keys.
DF_TRIAL_EMAIL_HMAC_KEY
# Hosted identity and mail (required outside development):
DF_WORKOS_CLIENT_ID
DF_WORKOS_API_KEY
DF_RESEND_API_KEY
# Reserved for BMONEY. Startup refuses even test keys until its durable adapter lands.
DF_STRIPE_SECRET_KEY
DF_STRIPE_WEBHOOK_SECRET
# Development only. Never set on the demo droplet:
DF_PORTAL_OUTBOX
DF_PORTAL_FAKE_CHECKOUT
DF_PORTAL_FAKE_PORTS
