[Unit]
Description=DungeonFlux hosted account API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=dungeonflux
Group=dungeonflux
WorkingDirectory=/opt/dungeonflux
EnvironmentFile=/etc/dungeonflux/demo.env
EnvironmentFile=/etc/dungeonflux/portal.env
ExecStart=/opt/dungeonflux/bin/df-portal-hosted
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/dungeonflux/app
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
