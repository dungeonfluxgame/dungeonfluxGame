# Staging mirror edge (docker compose): the same routing, fail-closed logging, admin socket and headers as
# Caddyfile.production, without public TLS (the staging ENVIRONMENT on DigitalOcean, staging.dungeonfluxdnd.com,
# runs Caddyfile.production with DF_PUBLIC_HOST set; this file is the local compose mirror). STATUS: UNVERIFIED.
# Published only on 127.0.0.1 by staging.compose.yml. See Caddyfile.production for the rationale (routing, hostnames,
# logging); the staging file must keep the same @capability matcher, log filters and header line
# (check-edge-redaction.sh enforces it on both files). The docs site is mounted from the repository's docs/.
{
	admin unix//run/caddy/admin.sock|0600
	auto_https off
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp "^(/[^/?%;]*)[^?]*([?].*)?$|^[^/].*$" "$1"
				request>headers>Referer delete
				request>headers>Sec-WebSocket-Protocol delete
				resp_headers>Location delete
			}
		}
	}
}

(control_plane) {
	reverse_proxy https://control-plane:8080 {
		health_uri /healthz/ready
		health_port 8084
		health_interval 5s
		health_timeout 2s
		flush_interval -1
		stream_close_delay 5m
		transport http {
			tls
			tls_server_name control-plane
			tls_trust_pool file /run/secrets/internal_ca_certificate
		}
	}
}

:8080 {
	encode zstd gzip

	@capability path /assets/* /media/*
	@always_dynamic path /app /app/* /api/* /sessions/* /join/* /media/* /auth/* /webhooks/*

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	header @capability >Referrer-Policy "no-referrer"

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "^(/[^/?%;]*)[^?]*([?].*)?$|^[^/].*$" "$1"
				request>headers>Referer delete
				request>headers>Sec-WebSocket-Protocol delete
				resp_headers>Location delete
			}
		}
	}

	handle @always_dynamic {
		import control_plane
	}

	handle {
		root * /srv/docs
		@docs file {
			try_files {path} {path}/index.html
		}
		handle @docs {
			# Security headers for the static docs site only (the browser client at /app/ sets its own in its own app, S3/O1/P).
			# The docs use no script at all, so script-src is 'none'; the 4 inline style attributes need style-src-attr; the
			# Google Fonts origins are allowed ONLY while the fonts are still loaded remotely (remove them when they are
			# self-hosted). No framing by anyone.
			header {
				Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src https://fonts.gstatic.com; script-src 'none'; media-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
				X-Frame-Options "DENY"
			}
			# /srv/docs is a BUILD OUTPUT (production: the docs/ tree packaged by the release job; this local mirror mounts the repository's docs/ for convenience). Even so the server never serves dotfiles (.nojekyll, .git) or source maps.
			file_server {
				hide .* *.map
			}
		}
		handle {
			import control_plane
		}
	}
}
