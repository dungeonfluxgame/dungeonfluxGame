# Demo is production-facing with one explicitly approved fixture executable exception.
DF_GAMEPLAY_DEV_CONTROL=off
# Demo never enables development state overrides.
DF_GAMEPLAY_DEV_OVERRIDES=off
# Demo never enables development accounts.
DF_DEV_ACCOUNTS=off
# Demo image uses df-transport-fixture for its --gameplay-demo entry point.
DF_FIXTURE_BUILD=demo-exception:df-transport-fixture --gameplay-demo
# Demo uses the real provider wiring; provider keys come from host env files.
DF_GAMEPLAY_PROVIDER_MODE=live
# The edge proxy forwards the public listener to localhost on the host.
DF_GAMEPLAY_LISTEN=127.0.0.1:63309
# Demo joins use the public apex over HTTPS.
DF_GAMEPLAY_PUBLIC_URL=https://dungeonfluxdnd.com
# Demo accepts only the two production browser origins.
DF_GAMEPLAY_ALLOWED_ORIGINS=https://dungeonfluxdnd.com,https://www.dungeonfluxdnd.com
# Demo public identity is WorkOS.
DF_GAMEPLAY_IDENTITY=workos
# Demo mail delivery uses the configured real provider.
DF_GAMEPLAY_MAIL_MODE=real
# Demo host injects API keys from /etc/dungeonflux/*.env; values never belong here.
DF_SECRET_ENV_DIR=/etc/dungeonflux
# Demo PostgreSQL password is mounted from the host secret file.
DF_GAMEPLAY_DATABASE_PASSWORD_FILE=/etc/dungeonflux/db_password
# Demo uses informational logs.
DF_LOG_LEVEL=info
# Demo disables application dotenv loading.
DF_GAMEPLAY_LOAD_DOTENV=off
# Demo uses host PostgreSQL over loopback; the host connection is protected by credentials.
DF_GAMEPLAY_DATABASE_TLS=loopback-plaintext
# Public traffic requires an active HTTPS edge termination.
DF_PUBLIC_TLS=enabled
# Demo explicitly disables public development control.
DF_GAMEPLAY_DEV_CONTROL_PUBLIC=off
# Demo storytelling provider is enabled by explicit policy.
DF_GAMEPLAY_STORYTELLER=on
# Demo story memory provider is enabled by explicit policy.
DF_GAMEPLAY_MEMORY=on
# Demo voice generation is enabled by explicit policy.
DF_GAMEPLAY_VOICE=on
# Demo music generation is enabled by explicit policy.
DF_GAMEPLAY_MUSIC=on
# Demo speech recognition is enabled by explicit policy.
DF_GAMEPLAY_STT=on
# Demo imagery is enabled by explicit policy.
DF_GAMEPLAY_IMAGERY=on
# Demo scene plates are enabled by explicit policy.
DF_GAMEPLAY_PLATES=on
# Demo creator portrait generation is off absent an explicit user action.
DF_GAMEPLAY_CREATOR_PORTRAITS=off
# Demo home video generation stays off.
DF_GAMEPLAY_HOME_VIDEO=off
# Demo scene video generation stays off.
DF_GAMEPLAY_SCENE_VIDEO=off
# Demo character video generation stays off.
DF_GAMEPLAY_CHARACTER_VIDEO=off
# Demo Jev integration is enabled by explicit policy.
DF_GAMEPLAY_JEV=on
# Demo splat world generation is enabled by explicit policy.
DF_GAMEPLAY_SPLAT_WORLDS=on
