# Local development binds only to the developer machine.
DF_GAMEPLAY_LISTEN=127.0.0.1:63309
# Local browser origin is loopback.
DF_GAMEPLAY_PUBLIC_URL=http://127.0.0.1:63309
# Local browser requests are restricted to loopback.
DF_GAMEPLAY_ALLOWED_ORIGINS=http://127.0.0.1:63309
# Local sign-in uses development passwords.
DF_GAMEPLAY_IDENTITY=local-password
# Local mail is captured in the development outbox.
DF_GAMEPLAY_MAIL_MODE=dev-outbox
# Local fake providers may be selected for offline work.
DF_GAMEPLAY_PROVIDER_MODE=fake-allowed
# Authenticated development routes are enabled for local use.
DF_GAMEPLAY_DEV_CONTROL=on
# Local state overrides are enabled only for development.
DF_GAMEPLAY_DEV_OVERRIDES=on
# Development account helpers are allowed locally.
DF_DEV_ACCOUNTS=on
# Local test fixtures may be built and used.
DF_FIXTURE_BUILD=on
# Local development uses verbose diagnostics.
DF_LOG_LEVEL=debug
# Local launch may load ignored developer .env credentials.
DF_GAMEPLAY_LOAD_DOTENV=on
# Local PostgreSQL may use the trust-auth scratch server without TLS.
DF_GAMEPLAY_DATABASE_TLS=loopback-plaintext
# Local video generation remains off by default.
DF_GAMEPLAY_HOME_VIDEO=off
# Local scene video generation remains off by default.
DF_GAMEPLAY_SCENE_VIDEO=off
# Local character video generation remains off by default.
DF_GAMEPLAY_CHARACTER_VIDEO=off
# Optional creator portrait generation is off unless explicitly requested.
DF_GAMEPLAY_CREATOR_PORTRAITS=off
# Local storytelling provider defaults on.
DF_GAMEPLAY_STORYTELLER=on
# Local memory provider defaults on.
DF_GAMEPLAY_MEMORY=on
# Local voice provider defaults on.
DF_GAMEPLAY_VOICE=on
# Local music provider defaults on.
DF_GAMEPLAY_MUSIC=on
# Local speech recognition defaults on.
DF_GAMEPLAY_STT=on
# Local imagery defaults on.
DF_GAMEPLAY_IMAGERY=on
# Local scene plates default on.
DF_GAMEPLAY_PLATES=on
# Local Jev integration defaults on.
DF_GAMEPLAY_JEV=on
# Local splat world generation defaults on.
DF_GAMEPLAY_SPLAT_WORLDS=on
