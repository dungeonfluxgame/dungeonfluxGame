# Production settings are loaded by the host; API credentials come from these host files.
DF_GAMEPLAY_DEV_CONTROL=off
# The hosted game never exposes development overrides.
DF_GAMEPLAY_DEV_OVERRIDES=off
# No development-account shortcut is enabled.
DF_DEV_ACCOUNTS=off
# No fixture build marker is enabled for standard production.
DF_FIXTURE_BUILD=off
# No provider fakes are permitted in production.
DF_GAMEPLAY_PROVIDER_MODE=live
# Public listener accepts traffic behind the TLS edge.
DF_GAMEPLAY_LISTEN=0.0.0.0:63309
# Public browser origin is the production apex.
DF_GAMEPLAY_PUBLIC_URL=https://dungeonfluxdnd.com
# Browser origins are explicitly restricted to production hosts.
DF_GAMEPLAY_ALLOWED_ORIGINS=https://dungeonfluxdnd.com,https://www.dungeonfluxdnd.com
# Identity is delegated to WorkOS in hosted production.
DF_GAMEPLAY_IDENTITY=workos
# Mail delivery uses the configured real provider.
DF_GAMEPLAY_MAIL_MODE=real
# Host injects the Resend API key through /etc/dungeonflux/*.env; never store its value here.
DF_RESEND_API_KEY=
# Optional sender defaults are supplied by the application.
DF_MAIL_FROM=
DF_MAIL_REPLY_TO=
# Daily send limit defaults to 100.
DF_MAIL_DAILY_CAP=100
# Host injects provider keys from /etc/dungeonflux/*.env; values never belong here.
DF_SECRET_ENV_DIR=/etc/dungeonflux
# Host injects PostgreSQL password through this file path.
DF_GAMEPLAY_DATABASE_PASSWORD_FILE=/etc/dungeonflux/db_password
# Production logs use the standard informational level.
DF_LOG_LEVEL=info
# Credentials and dotenv files are not loaded from the application directory.
DF_GAMEPLAY_LOAD_DOTENV=off
# Production game data connects to PostgreSQL TLS with certificate verification.
DF_GAMEPLAY_DATABASE_TLS=verify-full
# Public traffic requires an active HTTPS edge termination.
DF_PUBLIC_TLS=enabled
# Public development control is explicitly disabled.
DF_GAMEPLAY_DEV_CONTROL_PUBLIC=off
# Production storytelling provider is enabled by explicit policy.
DF_GAMEPLAY_STORYTELLER=on
# Production story memory provider is enabled by explicit policy.
DF_GAMEPLAY_MEMORY=on
# Production voice generation is enabled by explicit policy.
DF_GAMEPLAY_VOICE=on
# Production music generation is enabled by explicit policy.
DF_GAMEPLAY_MUSIC=on
# Production speech recognition is enabled by explicit policy.
DF_GAMEPLAY_STT=on
# Production scene imagery is enabled by explicit policy.
DF_GAMEPLAY_IMAGERY=on
# Production scene plate composition is enabled by explicit policy.
DF_GAMEPLAY_PLATES=on
# Creator portrait generation stays off absent an explicit user action.
DF_GAMEPLAY_CREATOR_PORTRAITS=off
# Optional video generation stays off in production by default.
DF_GAMEPLAY_HOME_VIDEO=off
# Scene video generation stays off in production by default.
DF_GAMEPLAY_SCENE_VIDEO=off
# Character video generation stays off in production by default.
DF_GAMEPLAY_CHARACTER_VIDEO=off
# Jev is enabled by explicit production policy.
DF_GAMEPLAY_JEV=on
# World Labs splat generation is enabled by explicit production policy.
DF_GAMEPLAY_SPLAT_WORLDS=on
