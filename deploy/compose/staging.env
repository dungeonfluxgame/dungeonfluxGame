# Non-secret compose variables for the staging mirror
# (docker compose --env-file deploy/images/images.lock --env-file deploy/compose/staging.env).
# The hosted binary reads NO environment variables (hosted-runtime-research.md 8.4): application settings
# live in the TOML files under deploy/config/staging/, and secrets are files under per-consumer directories.
# This file only parameterises the compose file itself.

DF_STAGING_PORT=8080
# Per-consumer secret directories (see deploy/scripts/staging-secrets.sh and deploy/secrets/secrets.manifest.json).
DF_STAGING_SECRETS_DIR=../../artifacts/tmp/staging/secrets

# A DISTINCT numeric uid per service (critic round 1c, item 3): a same-uid breakout could otherwise signal
# other services' processes and write their state. The primary GROUP is the consumer's secrets group (the group
# that owns its directory in production). Campaign runtimes share the runtime group (10002) but each slot has its
# own uid, allocated by the runner as 20000 + slot; per-placement files are 0400 owned by that uid, so one runtime
# cannot read another's token or key. Docker Desktop does not enforce ownership on bind mounts, so staging files
# are world-readable throwaway values; the production host enforces them (infra/cloud-init/df-secrets-install.sh).
# deploy/scripts/check-compose-policy.sh fails on a duplicated uid, on 65532 and on a runtime uid below 20000.
DF_UID_CONTROL_PLANE=10001
DF_GID_CONTROL_PLANE=10001
DF_GID_RUNTIME=10002
DF_UID_RUNTIME_1=20001
DF_UID_RUNTIME_2=20002
DF_UID_DISPATCHER=10003
DF_GID_DISPATCHER=10003
DF_UID_INGESTOR=10008
DF_GID_INGESTOR=10008
DF_UID_MIGRATE=10009
DF_UID_EDGE=10010
DF_UID_BUCKET_INIT=10011
DF_UID_DBGATE=10012

# Resource limits (every sizing decision is a variable; qualify with measured memory and CPU, plan 12.5).
DF_CP_MEM=1g
DF_CP_CPUS=1.0
DF_CP_PIDS=256
DF_RUNTIME_MEM=1536m
DF_RUNTIME_CPUS=1.0
DF_RUNTIME_PIDS=256
DF_EGRESS_MEM=256m
DF_PG_MEM=1g
DF_PG_MAX_CONNECTIONS=50
DF_OBJECT_STORE_MEM=512m
