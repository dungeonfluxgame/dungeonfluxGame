# Non-secret compose variables for the PRODUCTION and STAGING-ENVIRONMENT stack on an application Droplet
# (docker compose --env-file /opt/dungeonflux/current/release.lock --env-file /opt/dungeonflux/current/production.env ...).
# The release image carries both files. Nothing here is a secret or a hostname: hostnames are in /etc/dungeonflux/edge.env, secrets are
# files under /run/dungeonflux/secrets/<consumer>. The hosted binary reads no environment variables.

# A DISTINCT numeric uid per service; the primary group is the consumer's secrets group (infra/cloud-init/df-secrets-install.sh).
# The docker proxy is the only container with Docker socket access, through the host's docker group.
DF_UID_CONTROL_PLANE=10001
DF_GID_CONTROL_PLANE=10001
DF_UID_DISPATCHER=10003
DF_GID_DISPATCHER=10003
DF_UID_RUNNER_GROUP=10004
DF_UID_INGESTOR=10008
DF_GID_INGESTOR=10008
DF_UID_EDGE=10010
DF_UID_PROMETHEUS=10014
DF_UID_TEXTFILE=10015
# Alertmanager runs as the monitoring consumer (it reads the receiver URL from that secrets directory).
DF_UID_ALERTMANAGER=10006
DF_GID_ALERTMANAGER=10006
DF_UID_DBGATE=10012
DF_UID_PROXY=10013
# DF_DOCKER_GID is NOT set here: it is the host's `docker` group id, read with getent by `df-deploy release` into host.env
# (compose is started with --env-file release.lock --env-file production.env --env-file host.env).

# Where the edge gets its extra site files: the release's extra/ directory in production (the www redirect), an empty directory in
# the staging environment (no www host there).
DF_EDGE_EXTRA_DIR=/opt/dungeonflux/current/edge/extra

# Resource limits (every sizing decision is a variable; qualify with measured memory and CPU, plan 12.5).
DF_CP_MEM=1g
DF_CP_CPUS=1.0
DF_CP_PIDS=256
DF_EGRESS_MEM=256m
DF_INGESTOR_MEM=512m
DF_RUNNER_MEM=256m
DF_PROXY_MEM=64m
DF_PROM_MEM=512m
DF_ALERTMANAGER_MEM=128m
DF_TEXTFILE_MEM=64m
